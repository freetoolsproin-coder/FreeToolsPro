{
  "name": "freetoolspro",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "FreeToolsPro: fast, SEO-focused, browser-only tools. Astro static site with React islands.",
  "engines": {
    "node": ">=18.20.8"
  },
  "scripts": {
    "dev": "node scripts/write-ebooks.mjs && astro dev --host",
    "check:catalog": "node scripts/check-catalog.mjs",
    "build": "node scripts/check-catalog.mjs && node scripts/write-ebooks.mjs && astro build && node scripts/write-redirects.mjs && node scripts/check-seo.mjs",
    "preview": "astro preview --host",
    "start": "node server.mjs",
    "indexnow": "node scripts/indexnow.mjs",
    "check:live": "node scripts/check-live.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "ig:post": "node scripts/automation/ig-post.mjs",
    "ig:check": "node scripts/automation/ig-post.mjs --check",
    "seo:refresh": "node scripts/automation/seo-refresh.mjs",
    "seo:apply": "node scripts/automation/seo-refresh.mjs --apply",
    "seo:revert": "node scripts/automation/seo-refresh.mjs --revert",
    "seo:sitemap": "node scripts/automation/sitemap-submit.mjs",
    "seo:index": "node scripts/automation/gsc-index-monitor.mjs",
    "seo:audit": "node scripts/automation/seo-audit.mjs",
    "seo:audit:dist": "node scripts/automation/seo-audit.mjs --dist --strict",
    "seo:cwv": "node scripts/automation/cwv-monitor.mjs",
    "seo:report": "node scripts/automation/seo-report.mjs",
    "seo:daily": "node scripts/automation/sitemap-submit.mjs && node scripts/automation/gsc-index-monitor.mjs && node scripts/automation/seo-audit.mjs && node scripts/automation/seo-report.mjs",
    "seo:perf": "node scripts/automation/gsc-performance.mjs",
    "uptime": "node scripts/automation/uptime-check.mjs"
  },
  "dependencies": {
    "@astrojs/react": "^4.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.2.8",
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.1.3",
    "astro": "^5.13.0",
    "js-yaml": "^4.1.0",
    "lucide-react": "^0.460.0",
    "marked": "^15.0.12",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.34.5",
    "sql-formatter": "^15.6.6"
  }
}
