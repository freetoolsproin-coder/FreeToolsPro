{
  "name": "age-calculator",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-llms-txt.mjs && node scripts/generate-sitemap.mjs && vite build",
