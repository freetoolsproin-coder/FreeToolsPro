    "generate:tool-guides": "node scripts/generate-tool-blog-guides.mjs",
    "generate:seo-variants": "node -e \"import('./src/data/seoVariants/index.js').then(m=>console.log(JSON.stringify({count:m.listSeoVariants().length,sample:m.listSeoVariants().slice(0,5).map(v=>v.path)},null,2)))\"",
    "uptime:check": "node scripts/uptime-check.mjs",
    "uptime:test": "node scripts/uptime-check.mjs --force-alert",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write ."
  },
