# Copy this file to .env (same folder) and fill it in. .env is git-ignored; never commit it.
# Setup steps for each key: automation/README.md

# --- AI used for captions and SEO copy: anthropic | gemini | openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
# Optional: a specific model name for the provider above
LLM_MODEL=

# --- Instagram (@freetoolsproin26, must be a Business or Creator account)
# Only needed for the first run; after that the token is kept and refreshed in automation/state/ig-token.json
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0
# Skip a run if the last post was less than this many hours ago (stops double posts)
IG_MIN_HOURS=20
# Tool ids never to post, comma-separated
IG_SKIP=

# --- Google Search Console (for the SEO refresh)
# Service-account key file (keep it in automation/state/, which is git-ignored)
GSC_KEY_FILE=automation/state/gsc-key.json
# Domain property: sc-domain:freetoolspro.in   URL-prefix property: https://freetoolspro.in/
GSC_SITE=sc-domain:freetoolspro.in
# Pages refreshed per run, minimum impressions in 28 days, and days before a changed page can change again
SEO_LIMIT=5
SEO_MIN_IMPRESSIONS=50
SEO_COOLDOWN_DAYS=45

# --- SEO automation (automation/SEO-MONITORING.md)
# Site to check (default https://freetoolspro.in)
INDEX_SITE_URL=https://freetoolspro.in
# IndexNow key; the file public/<key>.txt must be live
INDEXNOW_KEY=787cb1b8b400efd9dd8a4225c8fa86a5
# PageSpeed Insights API key (console.cloud.google.com → enable "PageSpeed Insights API" → Credentials → API key)
PSI_API_KEY=
# Number of top tools checked for Core Web Vitals, besides the home page, /tools and every category hub
CWV_TOOL_LIMIT=12
# Minimum impressions (28 days) for a query to appear in the keyword-opportunity reports
PERF_MIN_IMPRESSIONS=20
# Pages with fewer contextual links than this get internal-link suggestions
AUDIT_MIN_CONTEXT_LINKS=3
# Optional: Slack / Discord / Google Chat incoming-webhook URL for daily alerts
SEO_ALERT_WEBHOOK=
