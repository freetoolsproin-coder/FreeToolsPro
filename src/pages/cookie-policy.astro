---
import Base from "../layouts/Base.astro";
import { LegalPage } from "../components/static/Pages.jsx";
import { LEGAL } from "../components/static/Legal.jsx";
import { webPageJsonLd } from "../lib/schema.js";
const page = LEGAL["cookie-policy"];
const jsonld = webPageJsonLd({ type: "WebPage", path: "/cookie-policy", name: page.title, description: page.description });
---

<Base title={page.title} description={page.description} path="/cookie-policy" jsonld={jsonld}>
  <LegalPage page={page} />
</Base>
