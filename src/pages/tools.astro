---
import Base from "../layouts/Base.astro";
import { CatalogPage } from "../components/static/Pages.jsx";
import { SITE } from "../data/site.js";
import { TOOLS } from "../data/catalog.js";
import { breadcrumbJsonLd } from "../lib/schema.js";

const jsonld = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `All ${SITE.name} tools`,
    url: `${SITE.url}/tools`,
    inLanguage: "en-IN",
    isPartOf: { "@id": `${SITE.url}/#website` },
    publisher: { "@id": `${SITE.url}/#organization` },
    mainEntity: {
      "@type": "ItemList",
      numberOfItems: TOOLS.length,
      itemListElement: TOOLS.map((t, i) => ({ "@type": "ListItem", position: i + 1, url: SITE.url + t.path, name: t.name })),
    },
  },
  breadcrumbJsonLd([["Home", "/"], ["All tools", "/tools"]]),
];
---

<Base
  title={`All ${TOOLS.length} Free Online Tools`}
  description={`Browse and search all ${TOOLS.length} free tools on ${SITE.name}: finance and tax calculators, PDF, image, LaTeX, student, text and developer tools.`}
  path="/tools"
  jsonld={jsonld}
  ogImage="/og/tools.png"
>
  <CatalogPage />
</Base>
