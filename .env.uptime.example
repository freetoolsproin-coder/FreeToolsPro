# FreeToolsPro uptime alerts
# Copy to .env.uptime and fill in values. Never commit real secrets.

UPTIME_URL=https://freetoolspro.in
UPTIME_TIMEOUT_MS=15000

# Where to send alerts
ALERT_EMAIL=support@freetoolspro.in
# Mobile in E.164 format (India example): +9198XXXXXXXX
ALERT_PHONE=

# EmailJS (same service as contact form; optional private key for server/CI)
EMAILJS_SERVICE_ID=service_uvfqag8
EMAILJS_TEMPLATE_ID=template_2zk68ln
EMAILJS_PUBLIC_KEY=BER8gUFpCxPGuMrsh
EMAILJS_PRIVATE_KEY=

# Twilio SMS (required for mobile alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
